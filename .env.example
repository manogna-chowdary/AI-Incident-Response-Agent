# Application
ENVIRONMENT=development
DEBUG=true

# PostgreSQL — structured incident data.
# DATABASE_URL is the only variable the backend reads; copy this file to
# backend/.env and replace the password with your real one.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/incident_response

# Groq — LLM reasoning. Leave the key blank until the analysis endpoint is wired
# up; the backend starts fine without it and returns HTTP 503 on analysis.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TIMEOUT_SECONDS=30

# Hindsight Cloud — long-term incident memory.
# HINDSIGHT_API_KEY never leaves the backend. It is never returned by the API
# and never logged. Leave blank to run without memory: incident creation still
# succeeds, reporting memory_retained=false, and the recall endpoint returns
# HTTP 503 until it is set.
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incident-response-agent
